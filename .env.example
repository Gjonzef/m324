KAFKA_BOOTSTRAP_SERVERS=swarm01.ispvoip.ch:9092,swarm02.ispvoip.ch:9092,swarm03.ispvoip.ch:9092
KAFKA_CDC_TOPICS=telephony_dev.telephony_dev.subscription,monthly_billing
KAFKA_GROUP_ID=billing-listener-dev
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_ALLOW_WILDCARD_TOPICS=false
LISTENER_POLL_TIMEOUT_SECONDS=1.0

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=18123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=ledger_dev
CLICKHOUSE_DATABASE=billing
CLICKHOUSE_SECURE=false
CLICKHOUSE_RECREATE_LEDGER_TABLE=false
# Optional override used only by docker compose services
DOCKER_CLICKHOUSE_HOST=clickhouse
DOCKER_CLICKHOUSE_PORT=8123

DEBEZIUM_CONNECTOR_NAME=telephony_dev
SOURCE_DATABASE_NAME=telephony_dev
SUBSCRIPTION_TABLE_NAME=subscription
MONTHLY_BILLING_TOPIC=monthly_billing

MARIADB_HOST=swarm02.ispvoip.ch
MARIADB_PORT=3306
MARIADB_DATABASE=telephony_dev
MARIADB_USER=ledger
# TODO: set real secret from your vault/password manager before run
MARIADB_PASSWORD=<set-real-secret>
MARIADB_CONNECT_TIMEOUT_SECONDS=5
MARIADB_CHARSET=utf8mb4
MARIADB_COLLATION=utf8mb4_general_ci

# Required for docker compose smoke test / GitLab CI smoke-test job
SMOKE_END_USER_ID=1
SMOKE_PRODUCT_ID=1
SMOKE_TOPIC=telephony_dev.telephony_dev.subscription
SMOKE_SUBSCRIPTION_ID=
SMOKE_WAIT_SECONDS=60

DEFAULT_CURRENCY=CHF
LOG_LEVEL=INFO
